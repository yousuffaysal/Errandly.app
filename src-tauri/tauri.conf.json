{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Errandly",
  "version": "0.1.5",
  "identifier": "studio.foxmen.errandly",
  "build": {
    "beforeDevCommand": "sh scripts/fetch-runtime.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/fetch-runtime.sh && sh scripts/sign-runtime.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Errandly",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co https://*.googleusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../NOTICE.md": "NOTICE.md"
    },
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Your personal AI for everyday work, on your Mac.",
    "copyright": "\u00a9 2026 Foxmen Studio",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MDc4MUQ3Njg1NDlGNzQKUldSMG4xUm8xNEVIcEQvSXo5TWxadDh5by95MjVua1FMUUlTVkhLcnVIZ2dYQlkzZVFMZHR3ZVYK",
      "endpoints": [
        "https://github.com/yousuffaysal/Errandly.app/releases/latest/download/latest.json"
      ]
    }
  }
}
